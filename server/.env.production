# 生产环境配置
NODE_ENV=production

# 数据库配置
DB_HOST=localhost
DB_USER=watermark_user
DB_PASSWORD=your_strong_password_here
DB_NAME=watermark_remover

# 服务器配置
PORT=3000

# 域名配置
DOMAIN=your-domain.com

# 安全配置
SESSION_SECRET=your_session_secret_here

# 日志级别
LOG_LEVEL=info

# 其他配置
MAX_REQUESTS_PER_MINUTE=100
ENABLE_RATE_LIMITING=true